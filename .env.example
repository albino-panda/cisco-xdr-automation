# cisco-xdr-automation environment template.
# Copy to .env (git-ignored). Needed only for code that runs outside XDR Automation;
# inside XDR, configure each integration as an Automation target instead.

# --- Cisco XDR (integrations/cisco-xdr) ---
XDR_CLIENT_ID=
XDR_CLIENT_SECRET=
XDR_API_BASE_URL=https://visibility.amp.cisco.com

# --- Cisco Secure Endpoint (integrations/secure-endpoint) ---
SE_CLIENT_ID=
SE_API_KEY=
SE_API_BASE_URL=

# --- Cisco Secure Email (Threat Defense / Gateway) (integrations/secure-email) ---
ETD_CLIENT_ID=
ETD_CLIENT_SECRET=
ETD_API_KEY=
ETD_API_BASE_URL=https://api.us.etd.cisco.com

# --- Cisco Umbrella / Secure Access (integrations/umbrella) ---
UMBRELLA_API_KEY=
UMBRELLA_API_SECRET=
UMBRELLA_BLOCK_LIST_ID=

# --- Microsoft Entra ID (via Microsoft Graph) (integrations/microsoft-entra) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Splunk (integrations/splunk) ---
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# --- Cisco Meraki (integrations/meraki) ---
MERAKI_API_KEY=
MERAKI_ORG_ID=
MERAKI_NETWORK_IDS=

# --- Cloudflare (integrations/cloudflare) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IP_LIST_ID=
CLOUDFLARE_GATEWAY_LIST_ID=

# --- ServiceNow (integrations/servicenow) ---
SNOW_INSTANCE_URL=
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=
SNOW_ASSIGNMENT_GROUP=
